# Server settings
AI_DEV_INDEX_HOST=0.0.0.0
AI_DEV_INDEX_PORT=8080
AI_DEV_INDEX_DATA_DIR=./data
AI_DEV_INDEX_CHANNELS_FILE=./channels.yaml

# Polling & ingestion settings
AI_DEV_INDEX_SYNC_INTERVAL_MINUTES=180
AI_DEV_INDEX_VIDEOS_PER_CHANNEL=5
AI_DEV_INDEX_REQUEST_DELAY_SECONDS=1.5
AI_DEV_INDEX_ENABLE_SCHEDULER=true

# Privacy / storage
# Keep true for internal self-hosted search; set false if ever publishing publicly.
AI_DEV_INDEX_STORE_TRANSCRIPTS=true

# Optional LLM summarization (works with any OpenAI-compatible endpoint:
# OpenAI, OpenRouter, local Ollama, LiteLLM, Gemini OpenAI-compat, etc.)
# Leave LLM_API_KEY empty to run with built-in keyword/topic extraction only.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Example for local Ollama on your NAS/LAN:
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b
